# Optional environment overrides (copy lines into your shell or a .env loader).
# Normal users don't need this file: use the Settings page instead.

# Local Ollama server - must be localhost/127.0.0.1 (remote hosts are rejected).
LINGUAAI_OLLAMA_HOST=http://127.0.0.1:11434
# Override the language model, e.g. qwen2.5:1.5b for low-memory laptops.
LINGUAAI_OLLAMA_MODEL=llama3.2:3b
# Override the Whisper model folder name (tiny.en, base.en, small.en).
LINGUAAI_WHISPER_MODEL=base.en
# Use a different database file (used by tests).
# LINGUAAI_DB=C:\path\to\test.db
